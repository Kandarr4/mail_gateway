# Скопируйте в .env и отредактируйте. Файл .env в репозиторий не попадает.

# --- Домен и приём почты ---
MG_DOMAIN=somnium.kz
# Имя, которым шлюз представляется в SMTP (HELO/EHLO). Пусто = mail.<домен>.
# Должно быть разрешимым доменным именем с PTR-записью на этот же адрес:
# имя машины вроде WIN-SERVER принимающие серверы считают признаком спама.
MG_HELO_NAME=
MG_SMTP_HOST=0.0.0.0
MG_SMTP_PORT=25
# Принимать письма только для зарегистрированных ящиков
MG_REQUIRE_KNOWN_MAILBOX=true
# Потолок размера письма целиком (не путать с лимитом одного вложения)
MG_MAX_MESSAGE_MB=35
# Писем в минуту с одного адреса, 0 — без ограничения
MG_SMTP_RATE_LIMIT_PER_MINUTE=60

# --- Шифрование входящих соединений (STARTTLS) ---
# Без сертификата почта принимается открытым текстом.
# Пути к файлам PEM; при использовании Nginx Proxy Manager они лежат
# в его томе: /data/letsencrypt/live/npm-<N>/fullchain.pem и privkey.pem
MG_TLS_CERT_FILE=
MG_TLS_KEY_FILE=

# --- Проверка подлинности отправителя (SPF, DKIM, DMARC) ---
# off      - не проверять
# annotate - проверять и записывать результат, принимать всё (по умолчанию)
# enforce  - отклонять то, что домен отправителя сам просит отклонять (p=reject)
MG_INBOUND_AUTH=annotate

# Читать заголовок PROXY protocol.
# ВКЛЮЧАТЬ ТОЛЬКО если перед шлюзом стоит доверенный прокси, который его шлёт.
# Иначе любой подключившийся сможет назваться чужим адресом и обойти SPF.
# При прямом пробросе порта (DNAT) оставить false.
MG_PROXY_PROTOCOL=false

# --- HTTP API ---
MG_API_HOST=0.0.0.0
MG_API_PORT=8025
# Токены доступа к API, через запятую (несколько — чтобы отзывать по одному)
MG_API_TOKENS=change-me-please
# Ограничение частоты запросов на токен, 0 — без ограничения
MG_RATE_LIMIT_PER_MINUTE=600

# --- Веб-панель управления (/admin) ---
MG_WEB_ENABLED=true
# Флаг Secure на cookie сессии. ОБЯЗАТЕЛЬНО true при доступе по HTTPS.
# При доступе по обычному HTTP оставить false, иначе вход не заработает.
MG_WEB_SECURE_COOKIES=false
MG_WEB_SESSION_HOURS=8
MG_WEB_LOGIN_ATTEMPTS_PER_MINUTE=10

# --- Хранилище ---
# Ключ шифрования содержимого: тела писем в БД и файлы вложений на диске.
# Создать: .venv\Scripts\python.exe manage.py encryption-keygen
# Пусто — содержимое хранится открытым текстом. Копию ключа держите ОТДЕЛЬНО
# от резервных копий БД: без ключа содержимое копий невосстановимо.
MG_ENCRYPTION_KEY_FILE=
MG_DATABASE_URL=sqlite:///mail_gateway.db
# PostgreSQL: postgresql+psycopg://user:pass@host/mail_gateway
MG_ATTACHMENT_DIR=data/attachments
# Куда складывать снимки базы. Периодичность и предельный объём задаются не
# здесь, а в панели: /admin/backup — их меняют на ходу, без перезапуска.
MG_BACKUP_DIR=data/backups
MG_MAX_ATTACHMENT_MB=25
# Через сколько часов удалять загруженные, но так и не отправленные файлы
MG_UPLOAD_TTL_HOURS=24

# --- Журналирование ---
MG_LOG_LEVEL=INFO
MG_LOG_DIR=data/logs
# true — строки JSON для сборщика логов, false — читаемый текст
MG_LOG_JSON=false
# Сколько суточных архивов хранить помимо текущего файла
MG_LOG_RETENTION_DAYS=10

# --- Исходящая почта ---
# direct - прямая доставка по MX-записям получателя
# relay  - через внешний SMTP-релей (нужны MG_RELAY_*)
MG_OUTBOUND_MODE=direct
MG_RELAY_HOST=
MG_RELAY_PORT=587
MG_RELAY_USERNAME=
MG_RELAY_PASSWORD=
MG_RELAY_USE_TLS=true
# Проверять сертификат релея. Выключать только для внутреннего релея с
# самоподписанным сертификатом: без проверки тот, кто вклинился в соединение,
# предъявляет свой сертификат и получает логин и пароль от релея.
MG_RELAY_VERIFY_TLS=true

# --- Подпись DKIM ---
# Создать ключ и получить запись для DNS:
#   .venv\Scripts\python.exe manage.py dkim-keygen
# Без подписи при прямой доставке письма почти наверняка попадут в спам.
MG_DKIM_PRIVATE_KEY_FILE=
MG_DKIM_SELECTOR=mail

# Повторные попытки отправки: пауза = база × 2^(попытка−1), но не больше
# потолка и с разбросом ±20%, чтобы отложенные одной аварией письма не
# вернулись в очередь единой пачкой.
MG_SEND_MAX_ATTEMPTS=5
MG_SEND_RETRY_BASE_SECONDS=60
MG_SEND_RETRY_MAX_SECONDS=3600

# Сколько писем отправляется одновременно. При единице очередь целиком стоит
# за первым же недоступным адресатом: SMTP-сессия висит до таймаута в 30 с.
MG_SEND_CONCURRENCY=4
